# PhishGuard configuration template
# Copy to .env and fill in values for your environment
# (defaults shown below are sane for docker compose; uncomment to override)

# ====== Required for production ======
JWT_SECRET=replace-with-32-byte-random-hex
PHISHGUARD_API_KEY=dev-key
# Only for local dev when you haven't set JWT_SECRET yet — the app refuses to
# start on the insecure default otherwise. Never set this in a real deployment.
ALLOW_INSECURE_JWT_SECRET=false

# ====== Layer 1 OSINT (recommended) ======
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
SHODAN_API_KEY=

# MISP threat intel feed (optional)
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=false

# ====== LLM Provider (single AI for the whole system) ======
# auto = uses whichever key below is set (claude first, then openai, then gemini)
# or set explicitly: claude | openai | gemini | heuristic
LLM_PROVIDER=auto
LLM_MODEL=          # optional — leave blank to use the provider default model

# Set ONE of these (whichever AI provider you have access to):
ANTHROPIC_API_KEY=  # Claude  — console.anthropic.com
OPENAI_API_KEY=     # OpenAI  — platform.openai.com
GEMINI_API_KEY=     # Gemini  — aistudio.google.com

# ====== Layer 3 sandbox ======
ENABLE_SANDBOX=true
SANDBOX_DOCKER_IMAGE=phishguard-sandbox:latest
L3_TRIGGER_THRESHOLD=0.45
MAX_SANDBOX_CONTAINERS=5
SANDBOX_TIMEOUT_SECONDS=60

# ====== Layer 4 SOAR integrations (optional) ======
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Outbound alert email (notify the security team on critical detections)
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_USE_TLS=true
ALERT_EMAIL_FROM=phishguard@example.com
ALERT_EMAIL_TO=secops@example.com

# ====== Storage backends ======
# (compose overrides these for the docker network; values here are for bare-metal)
# CHANGE the *_PASSWORD / *_SECRET_KEY values below before any real deployment —
# the shipped defaults are public (they're in this file's git history). The app
# warns at startup if any are still on the default; it won't refuse to start,
# since these gate optional integrations, but treat the warning as a blocker.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
REDIS_URL=redis://127.0.0.1:6379/0
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Neo4j (ThreatLens graph visualization) — NEO4J_AUTH in docker-compose.yml reads
# NEO4J_USER/NEO4J_PASSWORD from this same .env, so changing these here updates
# both the app's connection AND the actual Neo4j container's login in one place.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# MinIO (raw .eml evidence storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=phishguard
MINIO_SECRET_KEY=changeme123
MINIO_BUCKET=phishguard-evidence
MINIO_SECURE=false

# ====== ML pipeline ======
ML_MODEL_PATH=data/model.pkl
ML_LOCAL_DATA_DIR=data/training    # ground-truth training corpus — DO NOT change to verdicts dir
ML_VERDICT_LOG_DIR=data/verdicts   # live prediction logs (kept separate to prevent feedback-loop poisoning)
ML_BOOTSTRAP_ON_STARTUP=true
ML_S3_BUCKET=
AWS_REGION=us-east-1
GCS_BUCKET=

# ====== Layer 7 Gmail ingest (optional) ======
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/sa.json
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_ADMIN_IMPERSONATE_EMAIL=
GMAIL_QUARANTINE_LABEL=PhishGuard-Quarantine
GMAIL_SCANNED_LABEL=PhishGuard-Scanned
GOOGLE_CLOUD_PROJECT=
GMAIL_QUEUE_TOPIC=phishguard-gmail-notifications
GMAIL_QUEUE_SUBSCRIPTION=phishguard-gmail-sub
GMAIL_ENABLE_PULL_SUBSCRIBER=false

# ====== Local SMTP listener (for inline scanning) ======
SMTP_LISTEN_HOST=0.0.0.0
SMTP_LISTEN_PORT=8025

# ====== Layer 1 thresholds (advanced) ======
L1_VIRUSTOTAL_THRESHOLD=3
L1_ABUSEIPDB_THRESHOLD=25
L1_DOMAIN_AGE_DAYS=30
L1_MISP_THREAT_LEVELS=High,Medium

# ====== Layer 2 weights (advanced) ======
L2_NLP_WEIGHT=0.40
L2_BEHAVIORAL_WEIGHT=0.35
L2_STRUCTURAL_WEIGHT=0.25
L2_CRITICAL_THRESHOLD=0.90
L2_COMPOSITE_THRESHOLD=0.65
L2_ENGINE_TIMEOUT_SECONDS=5

# OpenCTI / MISP integration tokens (generate per-deployment; never commit real values)
OPENCTI_TOKEN=change-me
MISP_KEY=change-me
OPENCTI_ADMIN_EMAIL=admin@phishguard.local
OPENCTI_ADMIN_PASSWORD=changeme

# ====== Bombing/rate-limiting tuning (advanced — sensible defaults, rarely need changing) ======
# SMTP-level rate limits (app/security/smtp_rate_limiter.py)
SMTP_RATE_PER_IP=10        # emails per sending IP per minute
SMTP_RATE_PER_DOMAIN=20    # emails per sender domain per hour
SMTP_RATE_PER_RCPT=30      # emails to the same recipient per minute
SMTP_RATE_GLOBAL=60        # emails total per minute, across all senders
BOMBING_TCP_DROP_THRESHOLD=3
BOMBING_TCP_DROP_WINDOW_SECS=60
BOMBING_DEMO_MODE=false    # true relaxes timing so a bombing demo doesn't need real volume

# Mail-bombing detection (app/security/bombing_detector.py, bombing_triage.py)
BOMBING_PROTECTED_TLDS=.bank,.bank.in,.gov,.gov.in,.nic.in,.insurance
BOMBING_TIER2_WHOIS=false   # live WHOIS domain-age lookups during a bombing wave (slower, more accurate)
BOMBING_NEW_DOMAIN_DAYS=30
BOMBING_MAX_BUFFER_PER_RCPT=500
BOMBING_ANALYSIS_WINDOW_SECS=300   # how long buffered mail waits before release; lower only for demos
BOMBING_RELEASE_POLL_SECS=15
BOMBING_CLAIM_STALE_SECS=120

# ====== Misc paths / observability ======
PHISHGUARD_DB_PATH=data/phishguard.db
AUDIT_LOG_FILE=data/audit.jsonl
SETTINGS_OVERRIDE_FILE=data/settings_overrides.json
OTEL_EXPORTER_OTLP_ENDPOINT=   # optional — set to enable OpenTelemetry trace export
